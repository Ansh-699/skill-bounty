# ---- Required ----
# Postgres connection string
DATABASE_URL=postgres://indexer:indexer@localhost:5432/indexer
# Any Solana RPC (Helius recommended). Used by backfill + reconciler + doctor.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Shared secret. Must equal the `authHeader` you set when creating the Helius webhook.
# Use a long random string (>= 16 chars). `npm run init` can generate one.
WEBHOOK_AUTH_HEADER=replace-with-a-long-random-string

# ---- Optional ----
PORT=8080                       # webhook server port
API_PORT=8090                   # read API port
REDIS_URL=redis://localhost:6379
RECONCILE_INTERVAL_MS=30000

# ---- Optional: Yellowstone gRPC / LaserStream worker (Phase 4) ----
# GRPC_ENDPOINT=https://your-grpc-endpoint
# GRPC_TOKEN=your-grpc-token
# GRPC_ACCOUNTS=PROGRAM_ID_1,PROGRAM_ID_2
