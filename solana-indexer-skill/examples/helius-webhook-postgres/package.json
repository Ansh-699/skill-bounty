{
  "name": "solana-indexer-example",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "init": "node scripts/init.mjs",
    "doctor": "tsx --env-file-if-exists=.env src/doctor.ts",
    "dev": "tsx --env-file-if-exists=.env src/webhook-server.ts",
    "grpc": "tsx --env-file-if-exists=.env src/grpc-worker.ts",
    "api": "tsx --env-file-if-exists=.env src/api.ts",
    "backfill": "tsx --env-file-if-exists=.env src/backfill.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/reconciler.ts",
    "refresh": "tsx --env-file-if-exists=.env src/refresh.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "test": "tsx --env-file-if-exists=.env node_modules/.bin/vitest run --fileParallelism=false",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@triton-one/yellowstone-grpc": "5.0.9",
    "bs58": "^6.0.0",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
